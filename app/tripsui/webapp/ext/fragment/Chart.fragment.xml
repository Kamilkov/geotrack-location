<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core"
  xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
  <VBox width="100%" busy="{trip>/loading}">
    <MessageStrip text="{trip>/error}" type="Error" showIcon="true" class="sapUiSmallMarginBottom"
      visible="{= !!${trip>/error} }"/>
    <MessageStrip text="{i18n>noWorkout}" type="Information" showIcon="true"
      visible="{= !${trip>/loading} &amp;&amp; !${trip>/hasWorkout} &amp;&amp; !${trip>/error} }"/>
    <viz:VizFrame width="100%" height="280px" vizType="timeseries_line"
      uiConfig="{applicationSet:'fiori'}" vizProperties="{trip>/hrViz}"
      renderComplete=".extension.tripsui.ext.controller.ObjectPageExt.onChartRendered"
      visible="{= !!${trip>/hasWorkout} &amp;&amp; !${trip>/error} }">
      <viz:dataset>
        <viz.data:FlattenedDataset data="{trip>/hr}">
          <viz.data:dimensions>
            <viz.data:DimensionDefinition identity="time" name="{trip>/labels/chartTime}" value="{trip>t}" dataType="date"/>
          </viz.data:dimensions>
          <viz.data:measures>
            <viz.data:MeasureDefinition identity="hrAvg" name="{trip>/labels/chartHrAvg}" value="{trip>hrAvg}"/>
            <viz.data:MeasureDefinition identity="hrMax" name="{trip>/labels/chartHrMax}" value="{trip>hrMax}"/>
          </viz.data:measures>
        </viz.data:FlattenedDataset>
      </viz:dataset>
      <viz:feeds>
        <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="hrAvg,hrMax"/>
        <viz.feeds:FeedItem uid="timeAxis" type="Dimension" values="time"/>
      </viz:feeds>
    </viz:VizFrame>
    <MessageStrip text="{i18n>noWatchRoute}" type="Information" showIcon="true" class="sapUiSmallMarginTop"
      visible="{= !${trip>/loading} &amp;&amp; !!${trip>/hasWorkout} &amp;&amp; !${trip>/hasWatchRoute} &amp;&amp; !${trip>/error} }"/>
    <viz:VizFrame width="100%" height="280px" vizType="timeseries_line"
      uiConfig="{applicationSet:'fiori'}" vizProperties="{trip>/profileViz}"
      renderComplete=".extension.tripsui.ext.controller.ObjectPageExt.onChartRendered"
      visible="{= !!${trip>/hasWatchRoute} &amp;&amp; !${trip>/error} }">
      <viz:dataset>
        <viz.data:FlattenedDataset data="{trip>/profile}">
          <viz.data:dimensions>
            <viz.data:DimensionDefinition identity="time" name="{trip>/labels/chartTime}" value="{trip>t}" dataType="date"/>
          </viz.data:dimensions>
          <viz.data:measures>
            <viz.data:MeasureDefinition identity="altitude" name="{trip>/labels/chartAltitude}" value="{trip>altitudeM}"/>
            <viz.data:MeasureDefinition identity="speed" name="{trip>/labels/chartSpeed}" value="{trip>speedKmh}"/>
          </viz.data:measures>
        </viz.data:FlattenedDataset>
      </viz:dataset>
      <viz:feeds>
        <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="altitude"/>
        <viz.feeds:FeedItem uid="valueAxis2" type="Measure" values="speed"/>
        <viz.feeds:FeedItem uid="timeAxis" type="Dimension" values="time"/>
      </viz:feeds>
    </viz:VizFrame>
  </VBox>
</core:FragmentDefinition>
